# ─── NextAuth ────────────────────────────────────────────────
# URL do site em produção
NEXTAUTH_URL=https://seu-dominio.vercel.app

# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── Credenciais do Admin ────────────────────────────────────
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=

# ─── Banco de dados (Supabase) ───────────────────────────────
# Pegue em: supabase.com → projeto → Settings → Database
DATABASE_URL=

# ─── Stripe (pagamentos) ─────────────────────────────────────
# Pegue em: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# ─── Resend (newsletter) ─────────────────────────────────────
# Pegue em: resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=newsletter@seudominio.com.br

# ─── Brapi (cotações brasileiras) ────────────────────────────
# Gratuito em: brapi.dev
BRAPI_TOKEN=

# ─── Anthropic (IA para reescrita de notícias) ───────────────
# Pegue em: console.anthropic.com
ANTHROPIC_API_KEY=
